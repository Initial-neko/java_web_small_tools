          "parameters": [
            {
              "name": "fileId",
              "in": "path",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "上传返回的 fileId"
            },
            {
              "name": "sheetIndex",
              "in": "body",
              "type": "integer",
              "required": false,
              "default": 0,
              "enum": [],
              "description": "工作表索引"
            },
            {
              "name": "className",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "工作表名称",
              "enum": [],
              "description": "生成类名"
            },
            {
              "name": "packageName",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "com.example.model",
              "enum": [],
              "description": "包名"
            },
            {
              "name": "mode",
              "in": "body",
              "type": "string",
