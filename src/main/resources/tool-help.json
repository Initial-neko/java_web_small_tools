              "name": "driverJars",
              "in": "body",
              "type": "string | string[]",
              "required": false,
              "default": null,
              "enum": [],
              "description": "JDBC Driver Jar 路径；服务端路径，支持字符串或数组"
            },
            {
              "name": "driverClass",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "Driver Class（自定义数据库）；databaseType=custom 时必填"
            },
            {
              "name": "jdbcUrl",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "JDBC URL"
            },
            {
              "name": "username",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "用户名"
            },
            {
              "name": "password",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "密码"
            },
            {
              "name": "schema",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "Schema（可选）"
            },
            {
              "name": "tables",
              "in": "body",
              "type": "string | string[]",
              "required": true,
              "default": null,
              "enum": [],
              "description": "表名；支持字符串或数组"
            },
            {
              "name": "modelPackage",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "com.example.model",
              "enum": [],
              "description": "Model 包名"
            },
            {
              "name": "mapperPackage",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "com.example.mapper",
              "enum": [],
              "description": "Mapper 包名"
            },
            {
              "name": "xmlPackage",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "mapper",
              "enum": [],
              "description": "Mapper XML 目录"
            },
            {
              "name": "outputDir",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "./generated/mybatis",
              "enum": [],
              "description": "输出目录"
            },
            {
              "name": "overwrite",
              "in": "body",
              "type": "boolean",
              "required": false,
              "default": true,
              "enum": [],
              "description": "覆盖已生成文件"
            },
            {
              "name": "addRemarkComments",
              "in": "body",
              "type": "boolean",
              "required": false,
              "default": true,
              "enum": [],
              "description": "生成数据库字段备注"
            },
            {
              "name": "forceBigDecimals",
              "in": "body",
              "type": "boolean",
              "required": false,
              "default": false,
              "enum": [],
              "description": "DECIMAL/NUMERIC 强制使用 BigDecimal"
            },
            {
              "name": "trimStrings",
              "in": "body",
              "type": "boolean",
              "required": false,
              "default": false,
              "enum": [],
              "description": "String setter 自动 trim"
            },
            {
              "name": "useActualColumnNames",
              "in": "body",
              "type": "boolean",
              "required": false,
              "default": false,
              "enum": [],
              "description": "Java 属性直接使用数据库字段名"
            }
          ],
          "examples": [
            {
              "title": "调用示例 1",
              "body": {
                "databaseType": "dm",
                "driverJars": "drivers/DmJdbcDriver8.jar",
                "jdbcUrl": "jdbc:dm://127.0.0.1:5236",
