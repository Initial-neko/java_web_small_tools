{
  "schemaVersion": "1.0",
  "description": "任务页面与 HTTP 能力独立维护。参数通过 JSON 请求体传递，Excel 文件通过 multipart 上传；Java 内部辅助类和桌面功能不生成 Web 菜单。",
  "helpEndpoints": [
    "GET /api/help",
    "GET /api/tools/{name}/help",
    "GET /api/tools"
  ],
  "responseContract": "通用 execute 返回 {success,message,data}；业务失败可能仍是 HTTP 200，必须检查 success。Excel 接口返回扁平对象，其 output/fileId/rows 不在 data 下。帮助接口成功直接返回文档对象，未知工具帮助返回 HTTP 404。",
  "pages": [
    {
      "id": "json",
      "title": "JSON 工作台",
      "description": "格式化、压缩、校验与结构化对比",
      "tools": [
        "json-format",
        "json-compare"
      ],
      "labels": [
        "格式与校验",
        "结构化对比"
      ]
    },
    {
      "id": "text",
      "title": "文本对比",
      "description": "按行查看文本增删和修改",
      "tools": [
        "text-diff"
      ],
      "labels": [
        "按行对比"
      ]
    },
    {
      "id": "entity",
      "title": "实体生成",
      "description": "从 JSON、DDL 或 Excel 生成 Java 源码",
      "tools": [
        "json-to-java",
        "ddl-to-java",
        "excel-viewer",
        "jdbc-query-to-java"
      ],
      "labels": [
        "JSON",
        "DDL",
        "Excel",
        "数据库查询（高级）"
      ]
    },
    {
      "id": "sql",
      "title": "SQL 结构分析",
      "description": "提取语句、读写表和字段；支持批量",
      "tools": [
        "dm-sql-analyze",
        "dm-sql-batch"
      ],
      "labels": [
        "单条 SQL",
        "批量 SQL"
      ]
    },
    {
      "id": "metric",
      "title": "SQL 指标探查",
      "description": "提取指标、维度及跨 SQL 重复计算",
      "tools": [
        "sql-metric-probe",
        "sql-metric-batch"
      ],
      "labels": [
        "单条 SQL",
        "批量 SQL"
      ]
    },
    {
      "id": "lineage",
      "title": "SQL 血缘展示",
      "description": "从末端产出表出发，交互式钻取全链路血缘",
      "tools": [
        "lineage-viewer"
      ],
      "labels": [
        "血缘图谱"
      ]
    },
    {
      "id": "time",
      "title": "时间转换",
      "description": "时间戳与日期互转，支持秒和毫秒",
      "tools": [
        "timestamp"
      ],
      "labels": [
        "时间转换"
      ]
    }
  ],
  "advancedPages": [
    {
      "id": "mybatis",
      "title": "数据库代码生成",
      "description": "生成 Model、Mapper 和 XML，并写入服务端目录",
      "tools": [
        "mybatis-generator"
      ],
      "labels": [
        "代码生成"
      ]
    },
    {
      "id": "network",
      "title": "网络诊断",
      "description": "从服务端检测目标端口连通性",
      "tools": [
        "ip-port-checker"
      ],
      "labels": [
        "端口检测"
      ]
    }
  ],
  "environment": {
    "id": "environment",
    "title": "环境信息",
    "description": "查看运行此服务的机器及 JVM 信息",
    "tools": [
      "system-info"
    ],
    "labels": [
      "服务端环境"
    ]
  },
  "tools": [
    {
      "name": "timestamp",
      "title": "时间转换",
      "category": "time",
      "summary": "时间戳与日期互转，支持秒和毫秒",
      "notes": [
        "timestamp 按传入文本长度自动识别：不超过 10 位按秒，否则按毫秒。timestamp 在 type=toDate 时必填，datetime 在 type=toTimestamp 时必填。",
        "不填 timezone 使用服务端默认时区；建议明确使用 Asia/Shanghai。"
      ],
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/tools/timestamp/execute",
          "contentType": "application/json",
          "parameters": [
            {
              "name": "type",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "now",
              "enum": [
                "now",
                "toDate",
                "toTimestamp"
              ],
              "description": "操作类型"
            },
            {
              "name": "timestamp",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "时间戳（秒或毫秒）；type=toDate 时必填"
            },
            {
              "name": "datetime",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "日期时间；type=toTimestamp 时必填"
            },
            {
              "name": "format",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "yyyy-MM-dd HH:mm:ss",
              "enum": [],
              "description": "日期格式"
            },
            {
              "name": "timezone",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "时区（可选）"
            }
          ],
          "examples": [
            {
              "title": "now",
              "body": {
                "type": "now",
                "timezone": "Asia/Shanghai"
              }
            },
            {
              "title": "toDate",
              "body": {
                "type": "toDate",
                "timestamp": "1704067200",
                "timezone": "Asia/Shanghai"
              }
            },
            {
              "title": "toTimestamp",
              "body": {
                "type": "toTimestamp",
                "datetime": "2024-01-01 08:00:00",
                "timezone": "Asia/Shanghai"
              }
            }
          ],
          "testable": true,
          "response": "data.timestampSec、data.timestampMs、data.datetime"
        }
      ]
    },
    {
      "name": "json-format",
      "title": "格式与校验",
      "category": "json",
      "summary": "格式化、压缩、校验与结构化对比",
      "notes": [
        "input 是字符串，即使内容是 JSON，也需放在外层请求体的字符串字段中。validate 的格式正确性看 data.valid，格式错误也可能 success=true。"
      ],
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/tools/json-format/execute",
          "contentType": "application/json",
          "parameters": [
            {
              "name": "action",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "format",
              "enum": [
                "format",
                "compress",
                "validate",
                "escape",
                "unescape"
              ],
              "description": "操作"
            },
            {
              "name": "input",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "输入内容"
            }
          ],
          "examples": [
            {
              "title": "format",
              "body": {
                "action": "format",
                "input": "{\"name\":\"张三\",\"active\":true}"
              }
            },
            {
              "title": "compress",
              "body": {
                "action": "compress",
                "input": "{\"name\":\"张三\",\"active\":true}"
              }
            },
            {
              "title": "validate",
              "body": {
                "action": "validate",
                "input": "{\"name\":\"张三\",\"active\":true}"
              }
            },
            {
              "title": "escape",
              "body": {
                "action": "escape",
                "input": "{\"name\":\"张三\",\"active\":true}"
              }
            },
            {
              "title": "unescape",
              "body": {
                "action": "unescape",
                "input": "{\\\"name\\\":\\\"张三\\\"}"
              }
            }
          ],
          "testable": true,
          "response": "data.output；校验模式额外返回 data.valid"
        }
      ]
    },
    {
      "name": "json-to-java",
      "title": "JSON",
      "category": "entity",
      "summary": "从 JSON、DDL 或 Excel 生成 Java 源码",
      "notes": [
        "mode=mapping 输出显式取值代码，不生成普通实体。JSON 样本和 Java 内部推断类不各建独立菜单。"
      ],
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/tools/json-to-java/execute",
          "contentType": "application/json",
          "parameters": [
            {
              "name": "mode",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "normal",
              "enum": [
                "normal",
                "lombok",
                "mapping"
              ],
              "description": "输出模式"
            },
            {
              "name": "className",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "GeneratedEntity",
              "enum": [],
              "description": "类名"
            },
            {
              "name": "packageName",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "com.example.model",
              "enum": [],
              "description": "包名"
            },
            {
              "name": "input",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "JSON 样本"
            }
          ],
          "examples": [
            {
              "title": "调用示例 1",
              "body": {
                "input": "{\"user_id\":1,\"name\":\"张三\",\"orders\":[{\"id\":2}]}",
                "className": "User",
                "packageName": "com.example.model",
                "mode": "normal"
              }
            }
          ],
          "testable": true,
          "response": "data.output 为 Java 源码；data.className/packageName/fieldCount/mode"
        }
      ]
    },
    {
      "name": "ddl-to-java",
      "title": "DDL",
      "category": "entity",
      "summary": "从 JSON、DDL 或 Excel 生成 Java 源码",
      "notes": [
        "只解析 DDL，不连接数据库。"
      ],
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/tools/ddl-to-java/execute",
          "contentType": "application/json",
          "parameters": [
            {
              "name": "databaseType",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "dm",
              "enum": [
                "dm",
                "oracle"
              ],
              "description": "DDL 方言"
            },
            {
              "name": "mode",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "normal",
              "enum": [
                "normal",
                "lombok"
              ],
              "description": "输出模式"
            },
            {
              "name": "className",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "类名（留空则按表名生成）"
            },
            {
              "name": "packageName",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "com.example.model",
              "enum": [],
              "description": "包名"
            },
            {
              "name": "ddl",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "CREATE TABLE DDL"
            }
          ],
          "examples": [
            {
              "title": "调用示例 1",
              "body": {
                "ddl": "CREATE TABLE APP.T_ORDER (ID NUMBER(10,0), NAME VARCHAR2(100))",
                "databaseType": "dm",
                "className": "Order",
                "packageName": "com.example.model",
                "mode": "normal"
              }
            }
          ],
          "testable": true,
          "response": "data.output 为 Java 源码；data.className/packageName/fieldCount/databaseType"
        }
      ]
    },
    {
      "name": "jdbc-query-to-java",
      "title": "数据库查询（高级）",
      "category": "entity",
      "summary": "从 JSON、DDL 或 Excel 生成 Java 源码",
      "notes": [
        "由服务端连接真实数据库并执行 SELECT/WITH。驱动 jar 路径相对服务端工作目录，DM/Oracle 驱动需在内网自行提供。",
        "driverJars 支持字符串（逗号/分号/换行分隔）或字符串数组。custom 类型必须提供 driverClass；dm/oracle 自动推断。示例中的账号和地址必须替换。"
      ],
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/tools/jdbc-query-to-java/execute",
          "contentType": "application/json",
          "parameters": [
            {
              "name": "databaseType",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "dm",
              "enum": [
                "dm",
                "oracle",
                "custom"
              ],
              "description": "数据库类型"
            },
            {
              "name": "driverJars",
              "in": "body",
              "type": "string | string[]",
              "required": false,
              "default": null,
              "enum": [],
              "description": "JDBC Driver Jar 路径；服务端路径，支持字符串或数组"
            },
            {
              "name": "driverClass",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "Driver Class（自定义数据库）；databaseType=custom 时必填"
            },
            {
              "name": "jdbcUrl",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "JDBC URL"
            },
            {
              "name": "username",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "用户名"
            },
            {
              "name": "password",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "密码"
            },
            {
              "name": "sql",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "SELECT / WITH 查询"
            },
            {
              "name": "className",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "QueryResult",
              "enum": [],
              "description": "类名"
            },
            {
              "name": "packageName",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "com.example.model",
              "enum": [],
              "description": "包名"
            },
            {
              "name": "mode",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "normal",
              "enum": [
                "normal",
                "lombok"
              ],
              "description": "输出模式"
            }
          ],
          "examples": [
            {
              "title": "调用示例 1",
              "body": {
                "databaseType": "dm",
                "driverJars": "drivers/DmJdbcDriver8.jar",
                "jdbcUrl": "jdbc:dm://127.0.0.1:5236",
                "username": "YOUR_USER",
                "password": "YOUR_PASSWORD",
                "sql": "SELECT ID, NAME FROM APP.T_ORDER",
                "className": "QueryResult",
                "packageName": "com.example.model",
                "mode": "normal"
              }
            }
          ],
          "testable": false,
          "response": "data.output 为 Java 源码，data.fields 为字段元数据"
        }
      ]
    },
    {
      "name": "text-diff",
      "title": "按行对比",
      "category": "text",
      "summary": "按行查看文本增删和修改",
      "notes": [],
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/tools/text-diff/execute",
          "contentType": "application/json",
          "parameters": [
            {
              "name": "textA",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "原始文本（A）"
            },
            {
              "name": "textB",
              "in": "body",
              "type": "string",
              "required": false,
              "default": null,
              "enum": [],
              "description": "对比文本（B）"
            },
            {
              "name": "ignoreWhitespace",
              "in": "body",
