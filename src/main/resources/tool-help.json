            },
            {
              "name": "typeRow",
              "in": "body",
              "type": "integer",
              "required": false,
              "default": 2,
              "enum": [],
              "description": "类型行，0 为不使用"
            },
            {
              "name": "commentRow",
              "in": "body",
              "type": "integer",
              "required": false,
              "default": 3,
              "enum": [],
              "description": "注释行，0 为不使用"
            }
          ],
          "examples": [
            {
              "title": "生成 Java 源码",
