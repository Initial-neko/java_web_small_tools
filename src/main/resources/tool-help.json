              "name": "page",
              "in": "query",
              "type": "integer",
              "required": false,
              "default": 1,
              "enum": [],
              "description": "页号，从 1 开始"
            },
            {
              "name": "size",
              "in": "query",
              "type": "integer",
              "required": false,
              "default": 100,
              "enum": [],
              "description": "每页行数，必须使用正整数"
