        }
      ]
    },
    {
      "name": "dm-sql-analyze",
      "title": "单条 SQL",
      "category": "sql",
      "summary": "提取语句、读写表和字段；支持批量",
      "notes": [
        "仅静态解析，不执行 SQL。检查 data.status、warnings、errors；success=true 不等于全部 SQL 都成功解析。"
      ],
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/tools/dm-sql-analyze/execute",
          "contentType": "application/json",
          "parameters": [
            {
              "name": "sqlId",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "manual",
              "enum": [],
              "description": "SQL ID"
            },
            {
              "name": "source",
              "in": "body",
              "type": "string",
              "required": false,
              "default": "toolbox",
              "enum": [],
              "description": "来源（可选）"
            },
            {
              "name": "sql",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "达梦 SQL"
            }
          ],
          "examples": [
            {
              "title": "调用示例 1",
              "body": {
                "sqlId": "sql-1",
                "source": "demo",
                "sql": "SELECT ID, NAME FROM APP.T_ORDER WHERE STATUS = 1"
              }
            }
          ],
          "testable": true,
          "response": "data.status/statementTypes/readTables/writeTables/columns/warnings/errors"
        }
      ]
    },
    {
      "name": "dm-sql-batch",
      "title": "批量 SQL",
      "category": "sql",
      "summary": "提取语句、读写表和字段；支持批量",
      "notes": [
        "input 为字符串：内容可为 JSON 数组（string/object 元素），或用独立一行 -- @SQL 分隔 SQL 文本。",
        "对象支持 sqlId/sql/source/fileName/metadata；metadata 为键值对象，值转换为字符串。逐项状态见 data.results，总体 success=true 不代表所有条目解析成功。"
      ],
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/tools/dm-sql-batch/execute",
          "contentType": "application/json",
          "parameters": [
            {
              "name": "input",
              "in": "body",
              "type": "string",
              "required": true,
              "default": null,
              "enum": [],
              "description": "批量 SQL"
            }
          ],
          "examples": [
            {
              "title": "调用示例 1",
              "body": {
